{
  "manifest_version": 2,
  "name": "Отложенка",
  "version": "1.0.0",
  "description": "Копилка ссылок с группами: сохраняйте ссылки, не открывая — откройте, когда понадобится.",
  "permissions": ["storage", "contextMenus", "tabs", "notifications"],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_action": {
    "default_title": "Отложенка",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "browser_specific_settings": {
    "gecko": { "id": "links-hold@spruitys", "strict_min_version": "115.0" }
  },
  "background": {
    "scripts": ["background.js"]
  }
}
